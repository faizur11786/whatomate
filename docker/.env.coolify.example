# Paste into Coolify → Environment Variables
# Use DOUBLE underscores (WHATOMATE_DATABASE__HOST)

TZ=UTC
WHATOMATE_APP__ENVIRONMENT=production
WHATOMATE_APP__DEBUG=false
WHATOMATE_APP__ENCRYPTION_KEY=CHANGE_ME_32PLUS_CHARS
WHATOMATE_SERVER__ALLOWED_ORIGINS=https://whatomate.example.com
WHATOMATE_JWT__SECRET=CHANGE_ME_ANOTHER_32PLUS_CHARS

WHATOMATE_DATABASE__HOST=COOLIFY_POSTGRES_HOST
WHATOMATE_DATABASE__PORT=5432
WHATOMATE_DATABASE__USER=postgres
WHATOMATE_DATABASE__PASSWORD=
WHATOMATE_DATABASE__NAME=whatomate
WHATOMATE_DATABASE__SSL_MODE=disable

WHATOMATE_REDIS__HOST=COOLIFY_REDIS_HOST
WHATOMATE_REDIS__PORT=6379
WHATOMATE_REDIS__PASSWORD=

WHATOMATE_RATE_LIMIT__TRUST_PROXY=true
WHATOMATE_DEFAULT_ADMIN__EMAIL=admin@yourdomain.com
WHATOMATE_DEFAULT_ADMIN__PASSWORD=CHANGE_ME
